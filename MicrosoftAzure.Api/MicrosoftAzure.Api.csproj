<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <PackageProjectUrl>https://github.com/panoramicdata/MicrosoftAzure.Api/</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>Microsoft Azure API REST</PackageTags>
    <Title>MicrosoftAzure.Api</Title>
    <Description>A .NET API for Microsoft Azure</Description>
    <Summary>A .NET API for Microsoft Azure</Summary>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/panoramicdata/MicrosoftAzure.Api/</RepositoryUrl>
    <PackageReleaseNotes>
			Security fix: sensitive HTTP headers are now redacted in diagnostic output.

			Previously the Authorization header, and therefore a usable access token, was written verbatim
			into the Debug level request logging emitted by CustomHttpClientHandler. Any consumer running
			at Debug retained usable credentials for the life of its log store.

			Authorization, Proxy-Authorization, Cookie, Set-Cookie and common API key headers are now
			redacted in both request and response headers, along with any vendor-prefixed variant whose
			name ends in "Authorization". The authentication scheme and the credential length are
			retained, so failures remain diagnosable without exposing the credential.

			Consumers should upgrade and then review existing logs for previously captured tokens.
		</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>MicrosoftAzure.Api</PackageId>
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Refit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="Icon.png" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MicrosoftAzure.Api.Test" />
  </ItemGroup>
  <!-- Declared centrally in Directory.Build.props. Named here as well so that tooling looking
       for the versioning dependency at project level, Publish.ps1 among it, can find it. -->
  <ItemGroup>
    <PackageReference Update="Nerdbank.GitVersioning" />
  </ItemGroup>
</Project>